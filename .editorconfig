root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion

[*.{json,inputactions,asmdef}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Unity-serialized assets: let the Editor own their formatting
[*.{unity,prefab,asset,mat,anim,controller,meta,lighting,overrideController,physicMaterial}]
trim_trailing_whitespace = false
insert_final_newline = false
